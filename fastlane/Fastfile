default_platform :ios

platform :ios do

  desc "Push App Store metadata (name, description, keywords) — no binary upload"
  lane :metadata do
    app_store_connect_api_key(
      key_id:       "D7P7N5J6FV",
      issuer_id:    "85bc4fc9-c2cc-4efa-9ae0-4a0c165a7cd6",
      key_filepath: "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_D7P7N5J6FV.p8"
    )
    deliver(
      skip_binary_upload:              true,
      skip_screenshots:                true,
      skip_app_version_update:         true,
      precheck_include_in_app_purchases: false,
      force:                           true
    )
  end

  desc "Build and upload the binary only — leaves the App Store listing untouched"
  lane :build_only do
    app_store_connect_api_key(
      key_id:       "D7P7N5J6FV",
      issuer_id:    "85bc4fc9-c2cc-4efa-9ae0-4a0c165a7cd6",
      key_filepath: "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_D7P7N5J6FV.p8"
    )
    build_app(scheme: "Kharcha", export_method: "app-store")
    # `upload_to_testflight` rather than `deliver`: it sends the build and
    # nothing else. The `release` lane pushes names, keywords and release notes
    # alongside it, which is what you want on a version bump and not what you
    # want when a listing is already settled and being edited by hand.
    upload_to_testflight(skip_waiting_for_build_processing: true,
                         skip_submission: true)
  end

  desc "Full release: build, upload binary + metadata"
  lane :release do
    app_store_connect_api_key(
      key_id:       "D7P7N5J6FV",
      issuer_id:    "85bc4fc9-c2cc-4efa-9ae0-4a0c165a7cd6",
      key_filepath: "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_D7P7N5J6FV.p8"
    )
    build_app(scheme: "Kharcha", export_method: "app-store")
    deliver(
      skip_screenshots: true,
      force:            true,
      # Precheck cannot read in-app purchases through an App Store Connect API
      # key, so it fails the lane *after* a successful upload — the binary and
      # metadata are already up, and the exit code says otherwise. The metadata
      # lane already excluded them; this one did not.
      precheck_include_in_app_purchases: false
    )
  end

end
