rules_version = '2';

// Per-user isolation: a signed-in user can read/write only documents under
// their own /users/{uid} subtree. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
