    "Add a bank/pot and record what you save. The app tells you how much to keep for rent, subs, and goals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بنكًا أو وعاء ادخار وسجّل ما توفره. سيخبرك التطبيق بالمبلغ الذي يجب الاحتفاظ به للإيجار والاشتراكات والأهداف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ব্যাংক/পট যোগ করে আপনার সঞ্চয় রেকর্ড করুন। ভাড়া, সাবস্ক্রিপশন আর লক্ষ্যের জন্য কত রাখতে হবে, অ্যাপ তা আপনাকে জানিয়ে দেবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Konto/einen Topf hinzu und erfasse, was du sparst. Die App sagt dir, wie viel du für Miete, Abos und Ziele zurücklegen solltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un banco o una hucha y registra lo que ahorras. La app te dice cuánto reservar para el alquiler, las suscripciones y tus metas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une banque/cagnotte et enregistre ce que tu épargnes. L’app te dit combien garder pour le loyer, les abonnements et tes objectifs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंक/पॉट जोड़ें और अपनी बचत दर्ज करें। ऐप आपको बताता है कि किराया, सब्सक्रिप्शन और लक्ष्यों के लिए कितना रखना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan bank/pot dan catat tabunganmu. Aplikasi ini memberi tahu berapa yang perlu disisihkan untuk sewa, langganan, dan tujuanmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行口座や貯金箱を追加し、貯めた金額を記録しましょう。家賃やサブスク、目標のためにいくら確保すべきかアプリが教えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "은행 계좌나 저금통을 추가하고 저축한 금액을 기록하세요. 월세, 구독료, 목표를 위해 얼마를 남겨둬야 하는지 알려드려요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बँक/पॉट जोडा आणि तुम्ही केलेली बचत नोंदवा. भाडे, सबस्क्रिप्शन आणि उद्दिष्टांसाठी किती रक्कम बाजूला ठेवायची हे अ‍ॅप तुम्हाला सांगेल."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंक वा पोट थप्नुहोस् र आफूले बचत गरेको रकम रेकर्ड गर्नुहोस्। भाडा, सब्स्क्रिप्सन, र लक्ष्यका लागि कति राख्ने भनी एपले तपाईंलाई बताउँछ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma conta/caixinha e registre o quanto você guarda. O app mostra quanto reservar para aluguel, assinaturas e metas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте банк/копилку и записывайте, сколько вы откладываете. Приложение подскажет, сколько нужно оставить на аренду, подписки и цели."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு வங்கி/பாட்டைச் சேர்த்து நீங்கள் சேமிப்பதைப் பதிவு செய்யுங்கள். வாடகை, சந்தா, இலக்குகளுக்கு எவ்வளவு வைத்திருக்க வேண்டும் என்பதை ஆப் சொல்லும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బ్యాంకు/పొదుపు పెట్టెను జోడించి, మీరు దాచుకున్నది నమోదు చేయండి. అద్దె, సబ్‌స్క్రిప్షన్‌లు, లక్ష్యాల కోసం ఎంత ఉంచుకోవాలో యాప్ మీకు చెబుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir banka hesabı/kumbara ekleyip biriktirdiklerinizi kaydedin. Uygulama kira, abonelikler ve hedefler için ne kadar ayırmanız gerektiğini söyler."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بینک یا بچت برتن شامل کریں اور اپنی بچت کا ریکارڈ رکھیں۔ ایپ آپ کو بتائے گی کہ کرایہ، سبسکرپشنز اور اہداف کے لیے کتنا رکھنا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một ngân hàng/quỹ và ghi lại số tiền bạn tiết kiệm. Ứng dụng sẽ cho bạn biết cần giữ lại bao nhiêu cho tiền thuê nhà, các gói đăng ký và mục tiêu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加银行账户或钱罐并记录储蓄。应用会告诉你该为房租、订阅和目标各留多少。"
          }
        }
      }
    },
    "Add a friend to track shared expenses and who owes whom." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف صديقًا لتتبع المصاريف المشتركة ومعرفة من يدين لمن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাগাভাগি করা খরচ আর কে কার কাছে কত পাবে তা ট্র্যাক করতে একজন বন্ধু যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Freund hinzu, um gemeinsame Ausgaben zu verfolgen und zu sehen, wer wem was schuldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un amigo para llevar el control de gastos compartidos y quién le debe a quién."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un ami pour suivre les dépenses partagées et qui doit quoi à qui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्त जोड़ें ताकि साझा खर्च और किसका कितना बकाया है, ट्रैक कर सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan teman untuk melacak pengeluaran bersama dan siapa berutang kepada siapa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達を追加して、共有した支出や貸し借りを記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구를 추가해서 함께 쓴 돈과 누가 누구에게 얼마를 빚졌는지 관리하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समाईक खर्च आणि कोणाकडे किती देणे आहे हे ट्रॅक करण्यासाठी मित्र जोडा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा खर्च र कसले कसलाई तिर्नुपर्छ भन्ने ट्र्याक गर्न साथी थप्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um amigo para acompanhar despesas compartilhadas e quem deve a quem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте друга, чтобы отслеживать общие расходы и то, кто кому должен."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பகிரப்பட்ட செலவுகளையும் யார் யாருக்குக் கடன்பட்டுள்ளார்கள் என்பதையும் கண்காணிக்க ஒரு நண்பரைச் சேருங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పంచుకున్న ఖర్చులను, ఎవరికి ఎంత బాకీ ఉందో తెలుసుకోవడానికి ఒక స్నేహితుడిని జోడించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak harcamaları ve kimin kime borçlu olduğunu takip etmek için bir arkadaş ekleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشترکہ اخراجات اور کس پر کتنا واجب ہے، یہ ٹریک کرنے کے لیے دوست شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm bạn bè để theo dõi chi tiêu chung và ai nợ ai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加好友，记录共同开销和谁欠谁。"
          }
        }
      }
    },
