    "Short %@ for this month's commitments." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناقص %@ لتغطية التزامات هذا الشهر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই মাসের বাধ্যবাধকতার জন্য %@ কম আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zu wenig für die Verpflichtungen dieses Monats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te faltan %@ para los compromisos de este mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque %@ pour les engagements de ce mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस महीने की प्रतिबद्धताओं के लिए %@ कम है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang %@ untuk komitmen bulan ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月の固定費に対して%@不足しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달 고정 지출에 %@ 부족해요."
