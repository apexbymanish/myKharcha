    "You'll record each monthly payment yourself; we'll remind you before it's due." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستسجّل كل دفعة شهرية بنفسك؛ وسنذكّرك قبل موعد استحقاقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি নিজেই প্রতি মাসের পেমেন্ট রেকর্ড করবেন; বকেয়া হওয়ার আগে আমরা আপনাকে মনে করিয়ে দেব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erfasst jede monatliche Zahlung selbst; wir erinnern dich rechtzeitig vor Fälligkeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrarás cada pago mensual tú mismo; te avisaremos antes de que venza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu enregistreras chaque mensualité toi-même ; on te le rappellera avant l’échéance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप हर मासिक भुगतान खुद दर्ज करेंगे; हम इसके देय होने से पहले आपको याद दिलाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan mencatat setiap pembayaran bulanan sendiri; kami akan mengingatkanmu sebelum jatuh tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の支払いはご自身で記録します。期限前にリマインドします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매달 결제는 직접 기록하고, 만기 전에 알려드릴게요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही दर महिन्याचे पेमेंट स्वतः नोंदवाल; ते देय होण्यापूर्वी आम्ही तुम्हाला आठवण करून देऊ."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंले हरेक मासिक भुक्तानी आफैं रेकर्ड गर्नुहुनेछ; हामी तिर्नुअघि नै तपाईंलाई सम्झाउनेछौं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai registrar cada pagamento mensal manualmente; vamos te lembrar antes do vencimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы будете сами записывать каждый ежемесячный платёж; мы напомним вам заранее."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு மாதப் பணத்தையும் நீங்களே பதிவு செய்வீர்கள்; அது செலுத்த வேண்டிய நேரத்திற்கு முன் நாங்கள் உங்களுக்கு நினைவூட்டுவோம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ప్రతి నెలవారీ చెల్లింపును మీరే నమోదు చేసుకుంటారు; గడువుకు ముందు మేము మీకు గుర్తు చేస్తాము."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her aylık ödemeyi kendiniz kaydedeceksiniz; vadesinden önce size hatırlatacağız."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ ہر ماہانہ ادائیگی خود درج کریں گے؛ ہم واجب الادا ہونے سے پہلے آپ کو یاد دلائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ tự ghi từng khoản thanh toán hàng tháng; chúng tôi sẽ nhắc bạn trước khi đến hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每期付款由你自己记录；我们会在到期前提醒你。"
          }
        }
      }
    },
    "Your calm, private money tracker." : {
      "localizations" : {
