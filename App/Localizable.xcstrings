    "Add one from ➕ (choose Installment) to pay a purchase over months or track a loan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف واحدًا من ➕ (اختر قسط) لسداد عملية شراء على عدة أشهر أو لتتبع قرض."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো কেনাকাটা কয়েক মাসে পরিশোধ করতে বা ঋণ ট্র্যাক করতে ➕ থেকে একটি যোগ করুন (কিস্তি বেছে নিন)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge über ➕ eine hinzu (Ratenzahlung wählen), um einen Kauf über mehrere Monate abzuzahlen oder einen Kredit zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade uno desde ➕ (elige Cuota) para pagar una compra en varios meses o llevar el control de un préstamo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutes-en un depuis ➕ (choisis Mensualité) pour payer un achat en plusieurs mois ou suivre un prêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "➕ से एक जोड़ें (इंस्टॉलमेंट चुनें) ताकि किसी खरीद को महीनों में चुका सकें या लोन ट्रैक कर सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan satu dari ➕ (pilih Cicilan) untuk membayar pembelian selama beberapa bulan atau melacak pinjaman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "➕から追加（「分割払い」を選択）して、購入代金を数か月かけて支払ったり、ローンを管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "➕ 버튼에서 할부를 선택하면 구매 금액을 여러 달에 나눠 내거나 대출을 관리할 수 있어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खरेदीची रक्कम काही महिन्यांत भरण्यासाठी किंवा कर्ज ट्रॅक करण्यासाठी ➕ मधून एक जोडा (हप्ता निवडा)."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खरिद रकम महिनौंमा तिर्न वा ऋण ट्र्याक गर्न ➕ बाट एउटा थप्नुहोस् (किस्ता छान्नुहोस्)।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um em ➕ (escolha Parcelamento) para pagar uma compra em várias parcelas ou acompanhar um empréstimo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте через ➕ (выберите «Рассрочка»), чтобы платить за покупку по частям или отслеживать кредит."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாதங்களாகக் கட்டணம் செலுத்த அல்லது கடனைக் கண்காணிக்க ➕ இலிருந்து ஒன்றைச் சேருங்கள் (தவணை என்பதைத் தேர்ந்தெடுக்கவும்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొనుగోలును నెలల వారీగా చెల్లించడానికి లేదా రుణాన్ని ట్రాక్ చేయడానికి ➕ నుండి ఒకటి జోడించండి (Installment ఎంచుకోండి)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir satın alımı aylara bölmek veya bir krediyi takip etmek için ➕'den (Taksit'i seçin) ekleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "➕ سے ایک شامل کریں (قسط منتخب کریں) تاکہ خریداری کئی مہینوں میں ادا کریں یا قرض ٹریک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
