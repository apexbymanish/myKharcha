    "Sync failed. Check your connection or tap Back Up Now to retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت المزامنة. تحقق من اتصالك أو اضغط على \"إنشاء نسخة احتياطية الآن\" لإعادة المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক ব্যর্থ হয়েছে। আপনার সংযোগ পরীক্ষা করুন অথবা পুনরায় চেষ্টা করতে এখনই ব্যাকআপ নিন-এ ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung fehlgeschlagen. Überprüfe deine Verbindung oder tippe auf „Jetzt sichern“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error de sincronización. Revisa tu conexión o toca “Hacer copia ahora” para reintentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la synchronisation. Vérifie ta connexion ou appuie sur « Sauvegarder maintenant » pour réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक विफल रहा। अपना कनेक्शन जाँचें या फिर से कोशिश करने के लिए 'अभी बैकअप लें' पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi gagal. Periksa koneksi Anda atau ketuk Cadangkan Sekarang untuk mencoba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期に失敗しました。接続を確認するか、「今すぐバックアップ」をタップして再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화에 실패했어요. 연결 상태를 확인하거나 '지금 백업하기'를 탭해 다시 시도하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक अयशस्वी झाले. तुमचे कनेक्शन तपासा किंवा पुन्हा प्रयत्न करण्यासाठी 'आता बॅकअप घ्या' वर टॅप करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक असफल भयो। आफ्नो इन्टरनेट जडान जाँच्नुहोस् वा फेरि प्रयास गर्न “अहिले ब्याकअप गर्नुहोस्” ट्याप गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na sincronização. Verifique sua conexão ou toque em Fazer Backup Agora para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось синхронизировать. Проверьте подключение или нажмите «Создать копию сейчас», чтобы повторить попытку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒத்திசைவு தோல்வியடைந்தது. உங்கள் இணைப்பைச் சரிபார்க்கவும் அல்லது மீண்டும் முயற்சிக்க இப்போதே காப்புப் பிரதி எடு என்பதைத் தட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సింక్ విఫలమైంది. మీ కనెక్షన్‌ని తనిఖీ చేయండి లేదా మళ్లీ ప్రయత్నించడానికి 'ఇప్పుడే బ్యాకప్ చేయండి' నొక్కండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Senkronizasyon başarısız oldu. Bağlantınızı kontrol edin veya yeniden denemek için Şimdi Yedekle’ye dokunun."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سنک ناکام ہو گیا۔ اپنا کنکشن چیک کریں یا دوبارہ کوشش کے لیے “ابھی بیک اپ لیں” پر ٹیپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ thất bại. Hãy kiểm tra kết nối mạng hoặc chạm Sao lưu ngay để thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步失败，请检查网络连接，或点击“立即备份”重试。"
          }
        }
      }
    },
