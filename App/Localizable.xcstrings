    },
    "To cover all your bills, usual spending, and still save %lld%% — you'd need to earn at least this much per month." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتغطية جميع فواتيرك وإنفاقك المعتاد، مع ادخار %lld%% — تحتاج إلى كسب هذا القدر على الأقل شهريًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সব বিল, স্বাভাবিক খরচ মেটাতে আর তারপরও %lld%% সঞ্চয় করতে — প্রতি মাসে অন্তত এই পরিমাণ আয় করতে হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um alle deine Rechnungen und üblichen Ausgaben zu decken und trotzdem %lld%% zu sparen, müsstest du mindestens diesen Betrag pro Monat verdienen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cubrir todas tus facturas, tus gastos habituales y seguir ahorrando el %lld%%, necesitarías ganar al menos esto al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour couvrir toutes tes factures, tes dépenses habituelles, et épargner %lld %% — tu devrais gagner au moins ce montant par mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी बिल, सामान्य खर्च चुकाने और फिर भी %lld%% बचाने के लिए — आपको हर महीने कम से कम इतना कमाना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menutupi semua tagihan, pengeluaran biasa, dan tetap menabung %lld%% — kamu perlu berpenghasilan setidaknya sebesar ini per bulan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての支払いといつもの支出をカバーしつつ%lld%%を貯金するには、月に少なくともこの金額を稼ぐ必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 청구 항목과 평소 지출을 감당하면서 %lld%%를 저축하려면, 매달 최소 이만큼은 벌어야 해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमची सर्व बिले, नेहमीचा खर्च भागवून आणि तरीही %lld%% बचत करण्यासाठी — तुम्हाला दर महिन्याला किमान इतके कमवावे लागेल."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफ्ना सबै बिल र सामान्य खर्च धान्दै %lld%% बचत गर्न, तपाईंले महिनाको कम्तिमा यति कमाउनुपर्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cobrir todas as suas contas, os gastos habituais e ainda poupar %lld%% — você precisaria ganhar pelo menos isso por mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы покрыть все счета, обычные расходы и всё ещё откладывать %lld%%, вам нужно зарабатывать как минимум столько в месяц."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் அனைத்துக் கட்டணங்களையும், வழக்கமான செலவுகளையும் ஈடுகட்டி, %lld%% சேமிக்கவும் வேண்டுமெனில் — நீங்கள் மாதத்திற்குக் குறைந்தபட்சம் இவ்வளவையாவது சம்பாதிக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ బిల్లులన్నింటినీ, మామూలు ఖర్చులను భరిస్తూ %lld%% పొదుపు చేయడానికి — మీరు నెలకు కనీసం ఇంత సంపాదించాలి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm faturalarınızı, olağan harcamalarınızı karşılayıp %lld%% tasarruf edebilmek için ayda en az bu kadar kazanmanız gerekir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے تمام بلوں اور معمول کے اخراجات کو پورا کرتے ہوئے اور پھر بھی %lld%% بچانے کے لیے — آپ کو ماہانہ کم از کم اتنا کمانے کی ضرورت ہوگی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trang trải mọi hóa đơn, chi tiêu thường ngày và vẫn tiết kiệm %lld%% — bạn cần kiếm ít nhất số tiền này mỗi tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要覆盖所有账单和日常开销，同时还能存下 %lld%%，你每月至少需要赚这么多。"
          }
        }
      }
    },
    "To cover your commitments and usual spending while still saving %lld%%, aim to earn about this per month." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتغطية التزاماتك وإنفاقك المعتاد مع الاستمرار في ادخار %lld%%، اسعَ لكسب هذا المبلغ تقريبًا شهريًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বাধ্যবাধকতা আর স্বাভাবিক খরচ মেটাতে এবং তারপরও %lld%% সঞ্চয় করতে, প্রতি মাসে প্রায় এই পরিমাণ আয়ের লক্ষ্য রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine Verpflichtungen und üblichen Ausgaben zu decken und trotzdem %lld%% zu sparen, solltest du etwa diesen Betrag pro Monat verdienen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cubrir tus compromisos y gastos habituales sin dejar de ahorrar el %lld%%, intenta ganar aproximadamente esto al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour couvrir tes engagements et tes dépenses habituelles tout en épargnant %lld %%, vise environ ce montant par mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी प्रतिबद्धताओं और सामान्य खर्च को पूरा करते हुए %lld%% बचाने के लिए, हर महीने लगभग इतना कमाने का लक्ष्य रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menutupi komitmen dan pengeluaran biasamu sambil tetap menabung %lld%%, usahakan penghasilan sekitar ini per bulan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定費といつもの支出をカバーしつつ%lld%%を貯金するには、月におよそこの金額を稼ぐことを目指しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 지출과 평소 지출을 감당하면서 %lld%%를 저축하려면, 매달 약 이 정도를 벌어야 해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या जबाबदाऱ्या आणि नेहमीचा खर्च भागवून %lld%% बचत करण्यासाठी, दर महिन्याला अंदाजे इतके कमावण्याचे लक्ष्य ठेवा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफ्ना प्रतिबद्धता र सामान्य खर्च धान्दै %lld%% बचत गर्न, महिनामा लगभग यति कमाउने लक्ष्य राख्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cobrir seus compromissos e gastos habituais e ainda poupar %lld%%, procure ganhar cerca disso por mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы покрыть обязательства и обычные расходы, откладывая при этом %lld%%, старайтесь зарабатывать примерно столько в месяц."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கடமைகளையும் வழக்கமான செலவுகளையும் ஈடுசெய்து %lld%% சேமிக்க, மாதத்திற்கு இந்தத் தொகையை சம்பாதிக்க இலக்கு வையுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కట్టుబాట్లు, మామూలు ఖర్చులను భరిస్తూ %lld%% పొదుపు చేయడానికి, నెలకు దాదాపు ఇంత సంపాదించాలని లక్ష్యంగా పెట్టుకోండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taahhütlerinizi ve olağan harcamalarınızı karşılarken %lld%% tasarruf etmeye devam etmek için aylık olarak yaklaşık bu kadar kazanmayı hedefleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے واجبات اور معمول کے اخراجات پورے کرتے ہوئے %lld%% بچانے کے لیے، ماہانہ تقریباً اتنا کمانے کا ہدف رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trang trải các khoản cam kết và chi tiêu thường ngày trong khi vẫn tiết kiệm %lld%%, hãy đặt mục tiêu kiếm khoảng số tiền này mỗi tháng."
          }
        }
      }
    },
