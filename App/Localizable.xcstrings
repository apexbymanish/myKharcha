    "Notifications are off — reminders won't fire. Enable them in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة — لن تصل التذكيرات. فعّلها من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটিফিকেশন বন্ধ আছে — রিমাইন্ডার আসবে না। সেটিংসে গিয়ে চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen sind deaktiviert – Erinnerungen werden nicht ausgelöst. Aktiviere sie in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas: los recordatorios no sonarán. Actívalas en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées — les rappels ne se déclencheront pas. Active-les dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफ़िकेशन बंद हैं — रिमाइंडर नहीं आएंगे। सेटिंग्स में इन्हें चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi nonaktif — pengingat tidak akan muncul. Aktifkan di Pengaturan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がオフになっています。リマインダーが届きません。設定でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 꺼져 있어요 — 알림이 울리지 않아요. 설정에서 켜주세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफिकेशन्स बंद आहेत — स्मरणपत्रे येणार नाहीत. सेटिंग्जमध्ये ती सुरू करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचनाहरू बन्द छन् — रिमाइन्डरले काम गर्दैन। सेटिङमा गई सक्रिय गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas — os lembretes não vão disparar. Ative-as em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления отключены — напоминания не будут срабатывать. Включите их в настройках."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அறிவிப்புகள் அணைக்கப்பட்டுள்ளன — நினைவூட்டல்கள் வராது. அமைப்புகளில் அவற்றை இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నోటిఫికేషన్‌లు ఆఫ్‌లో ఉన్నాయి — రిమైండర్‌లు పని చేయవు. వాటిని Settingsలో ఎనేబుల్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler kapalı — hatırlatıcılar tetiklenmeyecek. Ayarlar'dan etkinleştirin."
