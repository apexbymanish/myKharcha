    "Your commitments exceed your income." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التزاماتك تتجاوز دخلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বাধ্যবাধকতা আপনার আয়ের চেয়ে বেশি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Verpflichtungen übersteigen dein Einkommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus compromisos superan tus ingresos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes engagements dépassent tes revenus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रतिबद्धताएं आपकी आय से ज़्यादा हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komitmenmu melebihi pemasukanmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定費が収入を上回っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 지출이 수입을 초과했어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या जबाबदाऱ्या तुमच्या उत्पन्नापेक्षा जास्त आहेत."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको प्रतिबद्धता आम्दानीभन्दा बढी छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus compromissos excedem sua receita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши обязательства превышают доход."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கடமைகள் உங்கள் வருமானத்தை விட அதிகமாக உள்ளன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కట్టుబాట్లు మీ ఆదాయాన్ని మించిపోయాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taahhütleriniz gelirinizi aşıyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے واجبات آپ کی آمدنی سے زیادہ ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản cam kết của bạn vượt quá thu nhập."
          }
        }
      }
    },
    "Your data is saved on this device only. Sign in with Apple to back it up and sync it across your devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك محفوظة على هذا الجهاز فقط. سجّل الدخول عبر Apple لنسخها احتياطيًا ومزامنتها عبر أجهزتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ডেটা শুধু এই ডিভাইসেই সংরক্ষিত আছে। ব্যাকআপ নিতে ও আপনার ডিভাইসগুলোর মধ্যে সিঙ্ক করতে Apple দিয়ে সাইন ইন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden nur auf diesem Gerät gespeichert. Melde dich mit Apple an, um sie zu sichern und geräteübergreifend zu synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos solo se guardan en este dispositivo. Inicia sesión con Apple para hacer copia de seguridad y sincronizarlos entre tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données sont enregistrées uniquement sur cet appareil. Connecte-toi avec Apple pour les sauvegarder et les synchroniser sur tous tes appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका डेटा सिर्फ़ इस डिवाइस पर सेव है। इसे बैकअप करने और अपने डिवाइसों में सिंक करने के लिए Apple से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamu hanya disimpan di perangkat ini. Masuk dengan Apple untuk mencadangkan dan menyinkronkannya di semua perangkatmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはこのデバイスにのみ保存されています。Appleでサインインすると、バックアップしてすべてのデバイスで同期できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 이 기기에만 저장돼요. Apple로 로그인하면 백업하고 여러 기기에서 동기화할 수 있어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा डेटा फक्त या डिव्हाइसवर सेव्ह आहे. बॅकअप घेण्यासाठी आणि तुमच्या डिव्हाइसेसवर सिंक करण्यासाठी Apple सह साइन इन करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको डेटा यही डिभाइसमा मात्र सुरक्षित छ। यसलाई ब्याकअप गरी सबै डिभाइसमा सिंक गर्न Apple बाट साइन इन गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados são salvos apenas neste dispositivo. Entre com a Apple para fazer backup e sincronizar entre seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные хранятся только на этом устройстве. Войдите через Apple, чтобы создавать резервные копии и синхронизировать их между устройствами."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தரவு இந்தச் சாதனத்தில் மட்டுமே சேமிக்கப்பட்டுள்ளது. அதைக் காப்புப் பிரதி எடுத்து உங்கள் சாதனங்கள் முழுவதும் ஒத்திசைக்க Apple மூலம் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ డేటా ఈ పరికరంలో మాత్రమే సేవ్ చేయబడుతుంది. దాన్ని బ్యాకప్ చేసి మీ పరికరాల్లో సింక్ చేయడానికి Appleతో సైన్ ఇన్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verileriniz yalnızca bu cihazda saklanır. Yedeklemek ve cihazlarınız arasında senkronize etmek için Apple ile giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا ڈیٹا صرف اس آلے پر محفوظ ہے۔ اسے بیک اپ اور اپنے آلات میں سنک کرنے کے لیے Apple کے ساتھ سائن ان کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của bạn chỉ được lưu trên thiết bị này. Đăng nhập bằng Apple để sao lưu và đồng bộ trên các thiết bị của bạn."
          }
