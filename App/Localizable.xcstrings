          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5초 후에 테스트 알림을 보내요. 탭한 후 앱을 백그라운드로 전환해야 알림을 볼 수 있어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 सेकंदात एक चाचणी नोटिफिकेशन पाठवते. ती पाहण्यासाठी टॅप केल्यानंतर अ‍ॅप बॅकग्राउंडला पाठवा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "५ सेकेन्डमा एउटा टेस्ट सूचना पठाउँछ। ट्याप गरेपछि एपलाई ब्याकग्राउन्डमा राख्नुहोस् ताकि देख्न सक्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara uma notificação de teste em 5 segundos. Coloque o app em segundo plano depois de tocar para vê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
