    "Add expenses and income with a tap — or paste a message and let your iPhone detect them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المصاريف والدخل بلمسة واحدة — أو الصق رسالة ودع آيفون يكتشفها تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক ট্যাপে খরচ আর আয় যোগ করুন — অথবা একটি মেসেজ পেস্ট করুন আর আপনার আইফোনকে সেগুলো শনাক্ত করতে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse Ausgaben und Einnahmen mit einem Tap – oder füge eine Nachricht ein und lass dein iPhone sie erkennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade gastos e ingresos con un toque, o pega un mensaje y deja que tu iPhone los detecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute dépenses et revenus en un geste — ou colle un message et laisse ton iPhone les détecter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैप करके खर्च और आय जोड़ें — या कोई मैसेज पेस्ट करें और अपने आईफ़ोन को उन्हें पहचानने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan pengeluaran dan pemasukan dengan sekali ketuk — atau tempel pesan dan biarkan iPhone-mu mendeteksinya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップひとつで支出や収入を記録。メッセージを貼り付ければiPhoneが自動で検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 한 번으로 지출과 수입을 기록하세요 — 메시지를 붙여넣으면 아이폰이 자동으로 인식해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एका टॅपने खर्च आणि उत्पन्न जोडा — किंवा मेसेज पेस्ट करा आणि तुमच्या iPhone ला ते ओळखू द्या."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ट्यापमै खर्च र आम्दानी थप्नुहोस् — वा म्यासेज पेस्ट गर्नुहोस् र आफ्नो iPhone लाई पत्ता लगाउन दिनुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione despesas e receitas com um toque — ou cole uma mensagem e deixe o iPhone detectá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте расходы и доходы одним нажатием — или вставьте сообщение, и iPhone распознает их сам."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு தட்டலில் செலவுகள் மற்றும் வருமானத்தைச் சேருங்கள் — அல்லது ஒரு செய்தியை ஒட்டி உங்கள் iPhone அதைக் கண்டறியட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక్క టాప్‌తో ఖర్చులు, ఆదాయాన్ని జోడించండి — లేదా మెసేజ్‌ని పేస్ట్ చేసి మీ iPhone వాటిని గుర్తించనివ్వండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gider ve gelirlerinizi tek dokunuşla ekleyin — ya da bir mesaj yapıştırın, iPhone'unuz bunları otomatik algılasın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ٹیپ سے اخراجات اور آمدنی شامل کریں — یا کوئی پیغام پیسٹ کریں اور اپنے آئی فون کو انہیں خود بخود پہچاننے دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm khoản chi và thu nhập chỉ bằng một chạm — hoặc dán tin nhắn để iPhone tự nhận diện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点即可记录收支，也可以粘贴短信让 iPhone 自动识别。"
          }
        }
      }
    },
