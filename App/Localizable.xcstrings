    "Cut a recurring bill or raise your income to get back on track." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قلّل فاتورة متكررة أو ارفع دخلك للعودة إلى المسار الصحيح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঠিক পথে ফিরতে কোনো পুনরাবৃত্ত বিল কমান বা আপনার আয় বাড়ান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche eine wiederkehrende Rechnung oder erhöhe dein Einkommen, um wieder auf Kurs zu kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce una factura recurrente o aumenta tus ingresos para volver a equilibrarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduis une facture récurrente ou augmente tes revenus pour te remettre sur les rails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस पटरी पर आने के लिए कोई रिकरिंग बिल घटाएं या अपनी आय बढ़ाएं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurangi tagihan berulang atau tingkatkan pemasukanmu agar kembali sesuai rencana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期的な支払いを減らすか、収入を増やして立て直しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정기 청구 항목을 줄이거나 소득을 늘려서 균형을 되찾아 보세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुन्हा रुळावर येण्यासाठी एखादे नियमित बिल कमी करा किंवा तुमचे उत्पन्न वाढवा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारम्बार आउने बिल घटाउनुहोस् वा आफ्नो आम्दानी बढाएर फेरि ट्र्याकमा फर्कनुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte uma conta recorrente ou aumente sua receita para voltar aos trilhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сократите один из регулярных счетов или увеличьте доход, чтобы выровнять баланс."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மீண்டும் சரியான பாதையில் வர, ஒரு தொடர் கட்டணத்தைக் குறைக்கவும் அல்லது உங்கள் வருமானத்தை அதிகரிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ట్రాక్‌లోకి రావడానికి పునరావృత బిల్లును తగ్గించండి లేదా మీ ఆదాయాన్ని పెంచండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrarlayan bir faturayı azaltın ya da gelirinizi artırın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوبارہ آنے والا بل کم کریں یا اپنی آمدنی بڑھائیں تاکہ دوبارہ ٹریک پر آ سکیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắt giảm một hóa đơn định kỳ hoặc tăng thu nhập để quay lại đúng hướng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减少一项固定账单或提高收入，让计划回到正轨。"
          }
        }
      }
    },
