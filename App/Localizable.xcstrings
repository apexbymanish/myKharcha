    "The app finds amounts and dates, and flags anything that looks like a duplicate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتشف التطبيق المبالغ والتواريخ، ويضع علامة على أي شيء يبدو مكررًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপটি পরিমাণ ও তারিখ খুঁজে বের করে, আর যা কিছু সদৃশ মনে হয় তা চিহ্নিত করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App findet Beträge und Daten und markiert alles, was wie ein Duplikat aussieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app detecta importes y fechas, y marca cualquier posible duplicado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app repère les montants et les dates, et signale tout ce qui ressemble à un doublon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप राशियां और तारीखें ढूंढता है, और जो कुछ भी डुप्लिकेट जैसा लगे उसे फ़्लैग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi menemukan nominal dan tanggal, serta menandai apa pun yang terlihat seperti duplikat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが金額と日付を見つけ、重複していそうなものにはフラグを立てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 금액과 날짜를 찾아내고, 중복으로 보이는 항목은 표시해줘요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अ‍ॅप रक्कम आणि तारखा शोधतो आणि डुप्लिकेट वाटणारी कोणतीही गोष्ट फ्लॅग करतो."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपले रकम र मितिहरू पत्ता लगाउँछ, र नक्कल जस्तो देखिने कुरालाई झन्डा लगाउँछ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app encontra valores e datas, e sinaliza qualquer coisa que pareça duplicada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение находит суммы и даты и отмечает похожее на дубликаты."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப் தொகைகளையும் தேதிகளையும் கண்டறிந்து, நகலாகத் தெரியும் எதையும் குறிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్ మొత్తాలు, తేదీలను కనుగొంటుంది, నకిలీలా కనిపించే వాటిని ఫ్లాగ్ చేస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama tutarları ve tarihleri bulur, yinelenen görünen kayıtları işaretler."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ رقوم اور تاریخیں تلاش کرتی ہے، اور جو کچھ نقل لگے اسے نشان زد کرتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng tìm số tiền và ngày tháng, đồng thời đánh dấu bất kỳ mục nào trông giống bị trùng lặp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会找出金额和日期，并标记疑似重复的条目。"
          }
        }
      }
    },
    "The monthly amount is total ÷ months — edit it if your actual payment differs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المبلغ الشهري هو الإجمالي ÷ عدد الأشهر — عدّله إذا كانت دفعتك الفعلية مختلفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাসিক পরিমাণ হলো মোট ÷ মাস — আপনার প্রকৃত পেমেন্ট আলাদা হলে এটি এডিট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der monatliche Betrag ergibt sich aus Gesamtbetrag ÷ Monate – passe ihn an, falls deine tatsächliche Zahlung abweicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El importe mensual es el total ÷ los meses; edítalo si tu pago real es distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le montant mensuel correspond au total ÷ nombre de mois — modifie-le si ton paiement réel est différent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक राशि कुल ÷ महीने होती है — अगर आपका असली भुगतान अलग है तो इसे संपादित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah bulanan adalah total ÷ jumlah bulan — ubah jika pembayaran sebenarnya berbeda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月々の金額は「合計 ÷ 月数」で計算されます。実際の支払額と異なる場合は編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 납입액은 총액 ÷ 개월 수로 계산돼요 — 실제 납입액이 다르다면 직접 수정하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक रक्कम म्हणजे एकूण ÷ महिने — तुमचे प्रत्यक्ष पेमेंट वेगळे असल्यास ती संपादित करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक रकम कुल ÷ महिना हो — तपाईंको वास्तविक भुक्तानी फरक भए यसलाई सम्पादन गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor mensal é total ÷ meses — edite se o seu pagamento real for diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежемесячная сумма = общая сумма ÷ количество месяцев — измените её, если ваш фактический платёж отличается."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாதத் தொகை என்பது மொத்தம் ÷ மாதங்கள் — உங்கள் உண்மையான கட்டணம் வேறுபட்டால் அதைத் திருத்தவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెలవారీ మొత్తం అనేది మొత్తం ÷ నెలలు — మీ అసలు చెల్లింపు వేరుగా ఉంటే దాన్ని ఎడిట్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık tutar, toplam ÷ ay sayısıdır — gerçek ödemeniz farklıysa düzenleyebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماہانہ رقم کل ÷ مہینے ہے — اگر آپ کی اصل ادائیگی مختلف ہو تو اسے تبدیل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền hàng tháng bằng tổng ÷ số tháng — hãy chỉnh sửa nếu khoản thanh toán thực tế của bạn khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每期金额为总额 ÷ 期数 — 若实际付款不同可自行修改。"
          }
        }
      }
    },
    "The monthly payment is logged automatically on the due day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُسجَّل الدفعة الشهرية تلقائيًا في يوم الاستحقاق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাসিক পেমেন্ট বকেয়ার দিনে স্বয়ংক্রিয়ভাবে লগ হয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
