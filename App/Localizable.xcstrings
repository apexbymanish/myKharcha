    "Fires a test notification in 5 seconds. Background the app after tapping to see it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلق إشعارًا تجريبيًا خلال 5 ثوانٍ. ضع التطبيق في الخلفية بعد النقر لرؤيته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "৫ সেকেন্ডে একটি টেস্ট নোটিফিকেশন পাঠায়। এটি দেখতে ট্যাপ করার পর অ্যাপটি ব্যাকগ্রাউন্ডে পাঠিয়ে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst in 5 Sekunden eine Test-Benachrichtigung aus. Lege die App danach in den Hintergrund, um sie zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una notificación de prueba en 5 segundos. Pon la app en segundo plano después de tocar para verla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déclenche une notification test dans 5 secondes. Mets l’app en arrière-plan après avoir appuyé pour la voir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 सेकंड में टेस्ट नोटिफ़िकेशन भेजता है। टैप करने के बाद इसे देखने के लिए ऐप को बैकग्राउंड में भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim notifikasi uji coba dalam 5 detik. Alihkan aplikasi ke latar belakang setelah mengetuk untuk melihatnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
