      }
    },
    "You'll record each monthly payment yourself; we'll remind you before it's due." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "매월 납부액은 직접 기록하시면 됩니다. 마감 전에 알려 드릴게요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हरेक मासिक भुक्तानी तपाईं आफैंले रेकर्ड गर्नुहुनेछ; समयसीमाभन्दा पहिले हामी सम्झाउनेछौं।"
          }
        }
      }
    },
    "Your calm, private money tracker." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "차분하고 비공개인 나만의 가계부."
