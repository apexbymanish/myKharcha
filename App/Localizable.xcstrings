    "This file isn't a valid Kharcha backup. Make sure you're selecting a file exported from Kharcha." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا الملف ليس نسخة احتياطية صالحة من Kharcha. تأكد من أنك تختار ملفًا تم تصديره من Kharcha."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফাইলটি একটি বৈধ Kharcha ব্যাকআপ নয়। নিশ্চিত করুন যে আপনি Kharcha থেকে এক্সপোর্ট করা একটি ফাইল বেছে নিচ্ছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Datei ist keine gültige Kharcha-Sicherung. Stelle sicher, dass du eine Datei auswählst, die aus Kharcha exportiert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este archivo no es una copia de seguridad válida de Kharcha. Asegúrate de seleccionar un archivo exportado desde Kharcha."
