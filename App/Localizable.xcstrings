    "Good time to log today's expenses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت مناسب لتسجيل مصروفات اليوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের খরচ লিখে রাখার ভালো সময়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guter Moment, die heutigen Ausgaben einzutragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buen momento para registrar los gastos de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le moment de noter les dépenses du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज के खर्च दर्ज करने का अच्छा समय है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu yang tepat mencatat pengeluaran hari ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の支出を記録するのによい時間です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 지출을 기록하기 좋은 시간이에요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आजचा खर्च नोंदवण्याची चांगली वेळ."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आजको खर्च टिप्न राम्रो समय।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boa hora para registrar os gastos de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удачное время записать сегодняшние траты."
