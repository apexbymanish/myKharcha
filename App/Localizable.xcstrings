        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்றைய செலவுகளைப் பதிவு செய்ய நல்ல நேரம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ రోజు ఖర్చులు నమోదు చేయడానికి మంచి సమయం."
          }
        },
