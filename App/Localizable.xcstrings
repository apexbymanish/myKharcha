    "Add transactions to see your spending report." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف معاملات لعرض تقرير إنفاقك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খরচের রিপোর্ট দেখতে লেনদেন যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buchungen hinzufügen, um den Ausgabenbericht zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade movimientos para ver tu informe de gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des opérations pour voir votre rapport de dépenses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्च रिपोर्ट देखने के लिए लेन-देन जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan transaksi untuk melihat laporan pengeluaran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引を追加すると支出レポートが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래를 추가하면 지출 리포트를 볼 수 있어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्चाचा अहवाल पाहण्यासाठी व्यवहार जोडा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्च रिपोर्ट हेर्न कारोबार थप्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione transações para ver seu relatório de gastos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте операции, чтобы увидеть отчёт о тратах."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செலவு அறிக்கையைப் பார்க்க பரிவர்த்தனைகளைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఖర్చు నివేదిక చూడటానికి లావాదేవీలు జోడించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcama raporunu görmek için işlem ekleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خرچ کی رپورٹ دیکھنے کے لیے لین دین شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
