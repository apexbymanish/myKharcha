    "All amounts are shown and totalled in this currency. When you paste text with foreign amounts (e.g. $10), they're converted to it automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض جميع المبالغ وتُجمع بهذه العملة. وعند لصق نص يحتوي مبالغ بعملة أخرى (مثل ‎$10)، تُحوَّل إليها تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব অঙ্ক এই মুদ্রায় দেখানো ও যোগ করা হয়। বিদেশি অঙ্কসহ লেখা পেস্ট করলে (যেমন $10) সেগুলো স্বয়ংক্রিয়ভাবে রূপান্তরিত হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Beträge werden in dieser Währung angezeigt und summiert. Fügst du Text mit fremden Beträgen ein (z. B. $10), werden sie automatisch umgerechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los importes se muestran y suman en esta moneda. Si pegas texto con importes extranjeros (p. ej. $10), se convierten automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les montants sont affichés et totalisés dans cette devise. Si vous collez un texte avec des montants étrangers (p. ex. 10 $), ils sont convertis automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी राशियाँ इसी मुद्रा में दिखती और जुड़ती हैं। विदेशी राशि वाला टेक्स्ट पेस्ट करने पर (जैसे $10) वह अपने आप बदल जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua nominal ditampilkan dan dijumlahkan dalam mata uang ini. Jika Anda menempel teks berisi nominal asing (mis. $10), nominal itu dikonversi otomatis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額はすべてこの通貨で表示・合計されます。外貨の金額を含む文章（例：$10）を貼り付けると自動的に換算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 금액은 이 통화로 표시되고 합산됩니다. 외화 금액이 포함된 텍스트($10 등)를 붙여넣으면 자동으로 환산됩니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व रकमा याच चलनात दाखवल्या व एकत्र केल्या जातात. परकीय रकमेचा मजकूर पेस्ट केल्यास (उदा. $10) तो आपोआप रूपांतरित होतो."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबै रकम यही मुद्रामा देखिन्छ र जोडिन्छ। विदेशी रकम भएको पाठ टाँस्दा (जस्तै $10) स्वतः रूपान्तरण हुन्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os valores são exibidos e somados nesta moeda. Ao colar texto com valores estrangeiros (ex.: $10), eles são convertidos automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все суммы отображаются и суммируются в этой валюте. Если вставить текст с суммой в другой валюте (например, $10), она пересчитается автоматически."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனைத்துத் தொகைகளும் இந்த நாணயத்தில் காட்டப்பட்டு கூட்டப்படும். வெளிநாட்டுத் தொகை உள்ள உரையை ஒட்டினால் ($10 போன்றவை) தானாக மாற்றப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అన్ని మొత్తాలు ఈ కరెన్సీలోనే చూపబడి, కలపబడతాయి. విదేశీ మొత్తాలున్న వచనాన్ని ($10 వంటివి) అతికిస్తే అవి ఆటోమేటిక్‌గా మార్చబడతాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm tutarlar bu para biriminde gösterilir ve toplanır. Yabancı tutar içeren metin yapıştırdığınızda (örn. $10) otomatik olarak çevrilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام رقوم اسی کرنسی میں دکھائی اور جمع کی جاتی ہیں۔ غیر ملکی رقم والا متن چسپاں کرنے پر (مثلاً $10) وہ خودکار طور پر تبدیل ہو جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi số tiền đều hiển thị và cộng theo đơn vị tiền này. Khi bạn dán văn bản có số tiền ngoại tệ (ví dụ $10), chúng sẽ được quy đổi tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有金额均以此币种显示并汇总。粘贴含外币金额的文本（如 $10）时会自动换算。"
          }
        }
      }
    },
