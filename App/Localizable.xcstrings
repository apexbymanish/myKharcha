          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बॅकअप कनेक्शन अयशस्वी झाले. पुन्हा कनेक्ट करण्यासाठी साइन आउट करून पुन्हा साइन इन करा."
