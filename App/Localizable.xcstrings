        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको नियमित खर्च आम्दानीभन्दा बढी छ।"
          }
        }
      }
    },
    "Your data is saved on this device only. Sign in with Apple to back it up and sync it across your devices." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "데이터는 이 기기에만 저장됩니다. Sign in with Apple로 로그인하면 데이터를 백업하고 여러 기기에서 동기화할 수 있습니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको डेटा यही यन्त्रमा मात्र सुरक्षित छ। यसलाई ब्याकअप गर्न र आफ्ना सबै यन्त्रहरूमा सिंक गर्न Sign in with Apple प्रयोग गर्नुहोस्।"
          }
        }
      }
    },
    "Your expenses are backed up and synced across your devices." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "지출 내역이 백업되어 여러 기기에서 동기화됩니다."
