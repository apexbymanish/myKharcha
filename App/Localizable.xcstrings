    "Everything lives on your device. Sign in later only if you want backup and sync." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء يبقى على جهازك. سجّل الدخول لاحقًا فقط إذا أردت النسخ الاحتياطي والمزامنة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবকিছু আপনার ডিভাইসেই থাকে। ব্যাকআপ আর সিঙ্ক চাইলে পরে সাইন ইন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf deinem Gerät. Melde dich später an, wenn du eine Sicherung und Synchronisierung möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se guarda en tu dispositivo. Inicia sesión más tarde solo si quieres copia de seguridad y sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur ton appareil. Connecte-toi plus tard seulement si tu veux la sauvegarde et la synchronisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ आपके डिवाइस पर रहता है। बैकअप और सिंक चाहिए तो बाद में साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua data tersimpan di perangkatmu. Masuk nanti hanya jika kamu ingin cadangan dan sinkronisasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデータはデバイス内に保存されます。バックアップや同期が必要になったら、後からサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터는 기기에만 저장돼요. 백업과 동기화가 필요할 때만 나중에 로그인하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व काही तुमच्या डिव्हाइसवरच सुरक्षित राहते. बॅकअप आणि सिंक हवे असल्यासच नंतर साइन इन करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबै कुरा तपाईंको डिभाइसमै रहन्छ। ब्याकअप र सिंक चाहिएमा मात्र पछि साइन इन गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no seu dispositivo. Entre depois somente se quiser backup e sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все данные хранятся на вашем устройстве. Войдите позже, если захотите резервное копирование и синхронизацию."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எல்லாமே உங்கள் சாதனத்தில் மட்டுமே சேமிக்கப்படும். காப்புப்பிரதி மற்றும் ஒத்திசைவு வேண்டுமெனில் மட்டும் பின்னர் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతిదీ మీ పరికరంలోనే ఉంటుంది. బ్యాకప్, సింక్ కావాలంటే మాత్రమే తర్వాత సైన్ ఇన్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey cihazınızda saklanır. Yedekleme ve senkronizasyon isterseniz daha sonra giriş yapabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سب کچھ آپ کے آلے پر محفوظ رہتا ہے۔ صرف اس صورت میں بعد میں سائن ان کریں اگر آپ بیک اپ اور سنک چاہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ được lưu trên thiết bị của bạn. Chỉ đăng nhập sau này nếu bạn muốn sao lưu và đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有数据都保存在你的设备上。只有需要备份和同步时才需要登录。"
          }
        }
      }
    },
