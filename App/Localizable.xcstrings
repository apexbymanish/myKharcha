          "stringUnit" : {
            "state" : "translated",
            "value" : "借りたお金を毎月返済していくものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌린 돈을 매달 갚아나가는 대출이에요."
