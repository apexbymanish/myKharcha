    "I track my expenses with Kharcha. It's free!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتتبّع مصروفاتي باستخدام Kharcha. إنه مجاني!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি Kharcha দিয়ে আমার খরচ ট্র্যাক করি। এটা ফ্রি!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verfolge meine Ausgaben mit Kharcha. Es ist kostenlos!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlo mis gastos con Kharcha. ¡Es gratis!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis mes dépenses avec Kharcha. C'est gratuit !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं अपना खर्च Kharcha से ट्रैक करता हूं। यह मुफ़्त है!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya melacak pengeluaran saya dengan Kharcha. Gratis!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharchaで支出を管理しています。無料です！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 Kharcha로 지출을 관리해요. 무료예요!"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मी माझा खर्च Kharcha ने ट्रॅक करतो. ते मोफत आहे!"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "म आफ्नो खर्च Kharcha बाट ट्र्याक गर्छु। यो फ्री छ!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu controlo meus gastos com o Kharcha. É grátis!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я отслеживаю расходы с Kharcha. Это бесплатно!"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நான் Kharcha மூலம் என் செலவுகளைக் கண்காணிக்கிறேன். இது இலவசம்!"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను Kharchaతో నా ఖర్చులను ట్రాక్ చేస్తున్నాను. ఇది ఉచితం!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamalarımı Kharcha ile takip ediyorum. Ücretsiz!"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میں اپنے اخراجات Kharcha کے ساتھ ٹریک کرتا ہوں۔ یہ مفت ہے!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi theo dõi chi tiêu bằng Kharcha. Miễn phí luôn!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我用 Kharcha 记录开销，完全免费！"
          }
        }
      }
    },
