    "Charts, a calendar, budgets, savings and a monthly plan keep you ahead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "차트, 캘린더, 예산, 저축, 월간 계획으로 앞서 나가세요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चार्ट, पात्रो, बजेट, बचत र मासिक योजनाले तपाईंलाई अगाडि राख्छ।"
          }
        }
      }
    },
    "Clear" : {
      "localizations" : {
