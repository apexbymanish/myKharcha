    "Set your payday and monthly salary to see days until payday and a safe daily spend on Home. Leave salary at 0 to hide it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد يوم راتبك وراتبك الشهري لمعرفة الأيام المتبقية حتى الراتب والإنفاق اليومي الآمن في الشاشة الرئيسية. اترك الراتب عند 0 لإخفائه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হোমে বেতনের দিন পর্যন্ত বাকি দিন আর নিরাপদ দৈনিক খরচ দেখতে আপনার বেতনের দিন ও মাসিক বেতন সেট করুন। লুকাতে চাইলে বেতন ০ রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege deinen Zahltag und dein Monatsgehalt fest, um auf der Startseite die Tage bis zum Zahltag und einen sicheren Tagesbetrag zu sehen. Lass das Gehalt bei 0, um es auszublenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura tu día de pago y tu salario mensual para ver en Inicio los días que faltan y cuánto puedes gastar al día. Deja el salario en 0 para ocultarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renseigne ton jour de paie et ton salaire mensuel pour voir les jours restants et un budget quotidien sûr sur l’accueil. Laisse le salaire à 0 pour le masquer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना सैलरी डे और मासिक वेतन सेट करें ताकि होम पर सैलरी डे तक के दिन और रोज़ाना सुरक्षित खर्च देख सकें। इसे छिपाने के लिए वेतन को 0 पर रहने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur hari gajian dan gaji bulananmu untuk melihat hitungan mundur hari gajian serta batas aman belanja harian di Beranda. Biarkan gaji tetap 0 untuk menyembunyikannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給料日と月給を設定すると、ホーム画面で給料日までの日数と1日あたりの安全な使用額を確認できます。給与を0のままにすると非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월급날과 월급을 설정하면 홈 화면에서 월급날까지 남은 일수와 하루 안전 지출액을 볼 수 있어요. 표시하고 싶지 않다면 월급을 0으로 두세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पगाराचा दिवस आणि मासिक पगार सेट करा म्हणजे होमवर पगारापर्यंतचे दिवस आणि दररोज सुरक्षितपणे खर्च करता येणारी रक्कम दिसेल. लपवण्यासाठी पगार 0 वर ठेवा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तलब दिनसम्म बाँकी दिन र होममा दैनिक सुरक्षित खर्च देख्न आफ्नो तलब दिन र मासिक तलब सेट गर्नुहोस्। लुकाउन तलब ०मा राख्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o dia do pagamento e o salário mensal para ver os dias até o pagamento e um gasto diário seguro na tela Início. Deixe o salário em 0 para ocultar essa informação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите день зарплаты и ежемесячный доход, чтобы видеть на главном экране дни до зарплаты и безопасную сумму трат в день. Оставьте зарплату на 0, чтобы скрыть её."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சம்பள நாள் வரையிலான நாட்களையும், பாதுகாப்பான தினசரி செலவையும் முகப்புத் திரையில் காண உங்கள் சம்பள நாளையும் மாத சம்பளத்தையும் அமைக்கவும். இதை மறைக்க சம்பளத்தை 0 ஆக விடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జీతం రోజు వరకు రోజులు, హోమ్‌లో సురక్షిత రోజువారీ ఖర్చు చూడటానికి మీ జీతం రోజు, నెలవారీ జీతాన్ని సెట్ చేయండి. దీన్ని దాచడానికి జీతాన్ని 0 వద్ద ఉంచండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa'da maaş gününe kalan günleri ve güvenli günlük harcamayı görmek için maaş gününüzü ve aylık maaşınızı ayarlayın. Gizlemek için maaşı 0 bırakın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہوم پر تنخواہ کے دن تک باقی دن اور روزانہ محفوظ خرچ دیکھنے کے لیے اپنی تنخواہ کا دن اور ماہانہ تنخواہ مقرر کریں۔ اسے چھپانے کے لیے تنخواہ 0 پر چھوڑ دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngày lương và lương hàng tháng để xem số ngày còn lại đến kỳ lương và mức chi tiêu an toàn mỗi ngày trên Trang chủ. Để lương ở mức 0 để ẩn mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置发薪日和月薪后，主页会显示距发薪日的天数和每日可花额度。月薪填 0 则隐藏。"
          }
        }
      }
    },
