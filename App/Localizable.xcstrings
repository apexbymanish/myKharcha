          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence দিয়ে ডিভাইসেই নতুনভাবে লেখা হয়েছে। সংখ্যাগুলো অ্যাপ দ্বারা নির্ভুলভাবে গণনা করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Gerät mit Apple Intelligence umformuliert. Die Zahlen werden exakt von der App berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reformulado en el dispositivo con Apple Intelligence. La app calcula las cifras con exactitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reformulé sur l’appareil avec Apple Intelligence. Les chiffres sont calculés précisément par l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence से डिवाइस पर ही दोबारा लिखा गया। संख्याओं की गणना ऐप द्वारा सटीक रूप से की जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disusun ulang di perangkat dengan Apple Intelligence. Angkanya dihitung secara tepat oleh aplikasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceによりデバイス上で言い換えられています。数値はアプリが正確に計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 기기에서 문구를 다듬었어요. 숫자는 앱이 정확하게 계산해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence वापरून डिव्हाइसवरच पुन्हा लिहिले आहे. आकडे अ‍ॅपद्वारे अचूकपणे मोजले जातात."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ले डिभाइसमै पुनः वाक्य बनाएको हो। अंकहरू भने एपले नै सटीक रूपमा गणना गरेको हो।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reformulado no dispositivo com a Apple Intelligence. Os números são calculados com exatidão pelo app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переформулировано на устройстве с помощью Apple Intelligence. Числа рассчитаны точно самим приложением."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence மூலம் சாதனத்திலேயே மறுசொல் செய்யப்பட்டது. எண்கள் ஆப்பால் துல்லியமாகக் கணக்கிடப்படுகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceతో పరికరంలోనే మళ్ళీ రాయబడింది. సంఖ్యలను యాప్ ఖచ్చితంగా లెక్కిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz üzerinde Apple Intelligence ile yeniden ifade edildi. Rakamlar uygulama tarafından tam olarak hesaplanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلے پر Apple Intelligence کے ذریعے دوبارہ الفاظ میں لکھا گیا۔ اعداد و شمار ایپ کے ذریعے بالکل درست شمار کیے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được diễn đạt lại ngay trên thiết bị bằng Apple Intelligence. Các con số được ứng dụng tính toán chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在设备端通过 Apple 智能改写措辞。数字由应用精确计算。"
          }
        }
      }
    },
