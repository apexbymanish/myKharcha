    "Auto-log records this expense automatically each month on the due date — no manual entry needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجل «التسجيل التلقائي» هذا المصروف تلقائيًا كل شهر في تاريخ الاستحقاق — لا حاجة لإدخال يدوي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় লগ প্রতি মাসে বকেয়ার তারিখে এই খরচটি নিজে থেকেই রেকর্ড করে — হাতে এন্ট্রি করার দরকার নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch erfassen“ bucht diese Ausgabe jeden Monat am Fälligkeitstag – keine manuelle Eingabe nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro automático anota este gasto automáticamente cada mes en la fecha de vencimiento, sin necesidad de introducirlo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement auto ajoute cette dépense automatiquement chaque mois à la date d’échéance — aucune saisie manuelle nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो-लॉग हर महीने देय तारीख पर इस खर्च को अपने आप दर्ज करता है — मैन्युअल एंट्री की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat otomatis mencatat pengeluaran ini secara otomatis setiap bulan pada tanggal jatuh tempo — tidak perlu entri manual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動記録をオンにすると、毎月支払期日にこの支出が自動的に記録されます。手動での入力は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 기록을 켜면 매달 결제일에 이 지출이 자동으로 기록돼요 — 직접 입력할 필요가 없어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो-लॉग दर महिन्याला देय तारखेला हा खर्च आपोआप नोंदवतो — मॅन्युअल एंट्रीची गरज नाही."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वतः-लगले यो खर्चलाई हरेक महिना तोकिएको मितिमा आफै रेकर्ड गर्छ — म्यानुअल रूपमा थप्नु पर्दैन।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro automático lança esta despesa todo mês na data de vencimento — sem precisar digitar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автозапись фиксирует этот расход автоматически каждый месяц в день платежа — вручную вводить не нужно."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-log ஒவ்வொரு மாதமும் நிலுவைத் தேதியில் இந்தச் செலவைத் தானாகவே பதிவு செய்யும் — கைமுறையாக உள்ளிட வேண்டியதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-log ఈ ఖర్చును ప్రతి నెలా గడువు తేదీన ఆటోమేటిక్‌గా నమోదు చేస్తుంది — మాన్యువల్‌గా ఎంటర్ చేయాల్సిన అవసరం లేదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
