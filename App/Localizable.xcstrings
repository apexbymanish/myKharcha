    "Backup connection failed. Sign out and sign in again to reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاتصال بالنسخ الاحتياطي. سجّل الخروج ثم الدخول مجددًا لإعادة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাকআপ সংযোগ ব্যর্থ হয়েছে। পুনরায় সংযোগ করতে সাইন আউট করে আবার সাইন ইন করুন।"
