    "Charts, a calendar, budgets, savings and a monthly plan keep you ahead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسوم البيانية والتقويم والميزانيات والمدخرات والخطة الشهرية تبقيك متقدمًا دائمًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চার্ট, ক্যালেন্ডার, বাজেট, সঞ্চয় আর মাসিক পরিকল্পনা আপনাকে সবসময় এগিয়ে রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagramme, ein Kalender, Budgets, Ersparnisse und ein Monatsplan halten dich auf Kurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gráficos, un calendario, presupuestos, ahorros y un plan mensual para ir siempre un paso por delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graphiques, calendrier, budgets, épargne et plan mensuel pour garder une longueur d’avance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चार्ट्स, कैलेंडर, बजट, बचत और मासिक योजना आपको हमेशा आगे रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafik, kalender, anggaran, tabungan, dan rencana bulanan membantumu selalu selangkah lebih maju."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフ、カレンダー、予算、貯金、そして月間プランで先手を打てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차트, 캘린더, 예산, 저축, 월간 플랜으로 한발 앞서 관리하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चार्ट्स, कॅलेंडर, बजेट्स, बचत आणि मासिक योजना तुम्हाला नेहमी पुढे ठेवतात."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चार्ट, पात्रो, बजेट, बचत र मासिक योजनाले तपाईंलाई सधैं अग्रसर राख्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gráficos, calendário, orçamentos, poupança e um plano mensal para você se manter no controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графики, календарь, бюджеты, накопления и план на месяц помогают быть на шаг впереди."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விளக்கப்படங்கள், நாட்காட்டி, பட்ஜெட்கள், சேமிப்பு மற்றும் மாதாந்திர திட்டம் உங்களை முன்னிலையில் வைத்திருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చార్ట్‌లు, క్యాలెండర్, బడ్జెట్‌లు, పొదుపు, నెలవారీ ప్లాన్ మిమ్మల్ని ముందుండేలా చేస్తాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafikler, takvim, bütçeler, birikimler ve aylık plan sizi hep bir adım önde tutar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چارٹس، کیلنڈر، بجٹ، بچت اور ماہانہ منصوبہ آپ کو ہمیشہ آگے رکھتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu đồ, lịch, ngân sách, tiết kiệm và kế hoạch hàng tháng giúp bạn luôn chủ động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图表、日历、预算、储蓄和月度计划，帮你走在前面。"
          }
        }
      }
    },
