    "Pulls your cloud data onto this device, overwriting matching local records." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسحب بياناتك السحابية إلى هذا الجهاز، ويستبدل السجلات المحلية المطابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ক্লাউড ডেটা এই ডিভাইসে নিয়ে আসে, মিলে যাওয়া লোকাল রেকর্ডগুলো ওভাররাইট করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt deine Cloud-Daten auf dieses Gerät und überschreibt dabei passende lokale Einträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga tus datos de la nube a este dispositivo y sobrescribe los registros locales coincidentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère tes données du cloud sur cet appareil, en écrasant les enregistrements locaux correspondants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके क्लाउड डेटा को इस डिवाइस पर लाता है, और मिलते-जुलते स्थानीय रिकॉर्ड को बदल देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menarik data cloud-mu ke perangkat ini, menimpa catatan lokal yang cocok."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドのデータをこのデバイスに取り込み、一致するローカルの記録を上書きします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 데이터를 이 기기로 가져오고, 일치하는 로컬 기록을 덮어써요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा क्लाउड डेटा या डिव्हाइसवर आणतो आणि जुळणाऱ्या स्थानिक नोंदी बदलतो."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको क्लाउड डेटालाई यो डिभाइसमा ल्याउँछ र मिल्दा स्थानीय रेकर्डहरूलाई ओभरराइट गर्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traz seus dados da nuvem para este dispositivo, substituindo os registros locais correspondentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает данные из облака на это устройство, перезаписывая совпадающие локальные записи."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கிளவுட் தரவை இந்த சாதனத்திற்கு கொண்டுவருகிறது, பொருந்தும் உள்ளூர் பதிவுகளை மேலெழுதுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ క్లౌడ్ డేటాను ఈ పరికరంలోకి తీసుకువస్తుంది, సరిపోలే లోకల్ రికార్డులను ఓవర్‌రైట్ చేస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulut verilerinizi bu cihaza çeker ve eşleşen yerel kayıtların üzerine yazar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے کلاؤڈ ڈیٹا کو اس آلے پر لاتا ہے، مماثل مقامی ریکارڈز کو اوور رائٹ کرتے ہوئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải dữ liệu đám mây của bạn về thiết bị này, ghi đè lên các bản ghi cục bộ trùng khớp."
          }
