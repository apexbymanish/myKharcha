    "Nothing logged today — add one?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسجَّل شيء اليوم — هل تريد إضافة واحد؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজ কিছুই লগ করা হয়নি — একটি যোগ করবেন?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute noch nichts erfasst – jetzt hinzufügen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no has registrado nada. ¿Quieres añadir uno?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d’enregistré aujourd’hui — tu en ajoutes une ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज कुछ भी दर्ज नहीं हुआ — एक जोड़ें?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada yang dicatat hari ini — tambahkan sekarang?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はまだ記録がありません。追加しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 기록한 내용이 없어요 — 추가할까요?"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज काहीही नोंदवलेले नाही — एक जोडायचे का?"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज केही पनि लग गरिएको छैन — एउटा थप्ने?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada registrado hoje — quer adicionar algo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня ничего не записано — добавить?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்று எதுவும் பதிவு செய்யப்படவில்லை — ஒன்று சேர்க்கவா?"
          }
        },
        "te" : {
