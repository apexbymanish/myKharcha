    "How to split your recommended savings across your goals, highest priority first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيفية توزيع مدخراتك الموصى بها على أهدافك، بدءًا بالأعلى أولوية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রস্তাবিত সঞ্চয় কীভাবে লক্ষ্যগুলোর মধ্যে ভাগ করবেন, সবচেয়ে গুরুত্বপূর্ণটি আগে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So verteilst du deine empfohlenen Ersparnisse auf deine Ziele – die wichtigsten zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo repartir el ahorro recomendado entre tus metas, empezando por la de mayor prioridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment répartir ton épargne recommandée entre tes objectifs, du plus prioritaire au moins prioritaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने लक्ष्यों में अनुशंसित बचत को कैसे बांटें, सबसे ज़्यादा प्राथमिकता वाले पहले।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara membagi tabungan yang direkomendasikan ke setiap tujuanmu, dimulai dari prioritas tertinggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめの貯金額を、優先度の高い目標から順に振り分ける方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 저축액을 목표별로 어떻게 나눌지, 우선순위가 높은 순서예요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमची शिफारस केलेली बचत उद्दिष्टांमध्ये कशी विभागायची, सर्वाधिक प्राधान्य असलेले आधी."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिफारिस गरिएको बचतलाई आफ्ना लक्ष्यहरूमा कसरी बाँड्ने, सबैभन्दा उच्च प्राथमिकतालाई पहिले राखेर।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como dividir sua poupança recomendada entre suas metas, começando pela de maior prioridade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как распределить рекомендуемые накопления между вашими целями — сначала самые приоритетные."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பரிந்துரைக்கப்பட்ட உங்கள் சேமிப்பை, அதிக முன்னுரிமையுள்ளதில் தொடங்கி, உங்கள் இலக்குகளுக்கு இடையே எவ்வாறு பிரிப்பது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ లక్ష్యాల మధ్య సిఫారసు చేసిన పొదుపును ఎలా పంచాలో, అత్యధిక ప్రాధాన్యత ముందుగా."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önerilen birikiminizin hedefleriniz arasında, en yüksek öncelikten başlayarak nasıl paylaştırılacağı."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی تجویز کردہ بچت اپنے اہداف میں کیسے تقسیم کریں، سب سے زیادہ ترجیح پہلے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách phân bổ khoản tiết kiệm được đề xuất cho các mục tiêu của bạn, ưu tiên cao nhất trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何把建议的储蓄额分配到各目标，优先级高的排在前面。"
          }
        }
      }
    },
