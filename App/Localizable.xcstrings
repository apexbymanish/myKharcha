        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या पुढील आठवड्यात देय असलेल्या जबाबदाऱ्या आहेत."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यी अर्को हप्ताभित्र तिर्नुपर्ने प्रतिबद्धताहरू हुन्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes são os compromissos que vencem na próxima semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это обязательства со сроком оплаты в течение следующей недели."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவை அடுத்த வாரத்திற்குள் நிலுவையில் உள்ள கடமைகள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇవి వచ్చే వారంలో గడువు ఉన్న కట్టుబాట్లు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar önümüzdeki hafta içinde vadesi gelecek taahhütler."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ وہ واجبات ہیں جو اگلے ہفتے کے اندر واجب الادا ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là các khoản cam kết đến hạn trong tuần tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是未来一周内到期的固定支出。"
          }
        }
      }
