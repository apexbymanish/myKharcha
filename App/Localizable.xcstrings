    "Deleting a payment also removes the expense it created." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف الدفعة يؤدي أيضًا إلى إزالة المصروف الذي أنشأته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো পেমেন্ট মুছে ফেললে সেটি থেকে তৈরি হওয়া খরচটিও মুছে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen einer Zahlung wird auch die dadurch erstellte Ausgabe entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un pago también se elimina el gasto que generó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un paiement retire aussi la dépense qu’il a créée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान हटाने से उससे बना खर्च भी हट जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus pembayaran juga akan menghapus pengeluaran yang dibuatnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いを削除すると、それによって作成された支出も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제를 삭제하면 그로 인해 생성된 지출도 함께 삭제돼요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेमेंट हटवल्याने त्यामुळे तयार झालेला खर्चही हटवला जातो."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुक्तानी मेटाउँदा त्यसले बनाएको खर्च पनि हट्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir um pagamento também remove a despesa que ele criou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление платежа также удалит созданный им расход."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு பணம் செலுத்துதலை நீக்கும்போது, அது உருவாக்கிய செலவும் நீக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చెల్లింపును తొలగించడం వల్ల అది సృష్టించిన ఖర్చు కూడా తొలగిపోతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ödemeyi silmek, onun oluşturduğu gideri de kaldırır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادائیگی حذف کرنے سے وہ خرچ بھی ہٹ جائے گا جو اس نے بنایا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa một khoản thanh toán cũng sẽ xóa khoản chi mà nó đã tạo ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除一笔付款会同时删除它生成的支出记录。"
          }
        }
