    "Total spending is down %lld%% from last month" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انخفض إجمالي الإنفاق بنسبة %lld%% عن الشهر الماضي"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গত মাসের তুলনায় মোট খরচ %lld%% কমেছে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtausgaben sind %lld%% niedriger als im Vormonat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gasto total bajó un %lld%% frente al mes pasado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses totales ont baissé de %lld%% par rapport au mois dernier"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले महीने से कुल खर्च %lld%% घटा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total pengeluaran turun %lld%% dari bulan lalu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "総支出は先月比 %lld%% 減です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 지출이 지난달보다 %lld%% 줄었어요"
