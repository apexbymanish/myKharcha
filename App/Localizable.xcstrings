        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلاعات بند ہیں — یاد دہانیاں فعال نہیں ہوں گی۔ انہیں ترتیبات میں فعال کریں۔"
          }
