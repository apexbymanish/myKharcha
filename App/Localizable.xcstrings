    "Erase & Replace deletes all your current data, then restores from this backup. Keep & Merge only adds records not already on this device. Erase & Replace cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حذف واستبدال يمسح جميع بياناتك الحالية ثم يستعيد من هذه النسخة الاحتياطية. الاحتفاظ والدمج يُضيف فقط السجلات غير الموجودة على هذا الجهاز. لا يمكن التراجع عن حذف واستبدال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মুছে প্রতিস্থাপন করুন আপনার সব বর্তমান ডেটা মুছে দেয়, তারপর এই ব্যাকআপ থেকে পুনরুদ্ধার করে। রাখুন ও মার্জ করুন শুধুমাত্র সেই রেকর্ডগুলো যোগ করে যা এই ডিভাইসে নেই। মুছে প্রতিস্থাপন করুন পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Löschen & Ersetzen löscht alle deine aktuellen Daten und stellt dann diese Sicherung wieder her. Beibehalten & Zusammenführen fügt nur Einträge hinzu, die noch nicht auf diesem Gerät vorhanden sind. Löschen & Ersetzen kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Borrar y reemplazar elimina todos tus datos actuales y luego los restaura desde esta copia de seguridad. Conservar y combinar solo añade los registros que no están en este dispositivo. Borrar y reemplazar no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Effacer et remplacer supprime toutes tes données actuelles, puis restaure depuis cette sauvegarde. Conserver et fusionner ajoute uniquement les opérations qui ne sont pas déjà sur cet appareil. Effacer et remplacer est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मिटाएं और बदलें आपका सारा मौजूदा डेटा हटा देता है, फिर इस बैकअप से रीस्टोर करता है। रखें और मर्ज करें सिर्फ़ वही रिकॉर्ड जोड़ता है जो इस डिवाइस पर नहीं हैं। मिटाएं और बदलें को वापस नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hapus & Ganti menghapus semua data kamu saat ini, lalu memulihkan dari cadangan ini. Pertahankan & Gabung hanya menambahkan catatan yang belum ada di perangkat ini. Hapus & Ganti tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“消去して置き換え”を選ぶと、現在のデータがすべて削除され、このバックアップから復元されます。“保持してマージ”はこのデバイスにないデータだけを追加します。“消去して置き換え”は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "지우고 교체하기는 현재 데이터를 모두 지우고 이 백업으로 복원해요. 유지하고 합치기는 이 기기에 없는 기록만 추가해요. 지우고 교체하기는 되돌릴 수 없어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मिटवा & बदला तुमचा सध्याचा सर्व डेटा कायमचा मिटवतो आणि नंतर या बॅकअपमधून रिस्टोअर करतो. ठेवा & एकत्र करा फक्त त्याच नोंदी जोडतो ज्या या डिव्हाइसवर आधीपासून नाहीत. मिटवा & बदला पूर्ववत करता येत नाही."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“मेटाउनुस् र बदल्नुस्”ले तपाईंको सबै हालको डेटा मेटाई यो ब्याकअपबाट पुनर्स्थापना गर्छ। “राख्नुस् र मर्ज गर्नुस्”ले यो डिभाइसमा नभएका रेकर्डहरू मात्र थप्छ। “मेटाउनुस् र बदल्नुस्” पछि फिर्ता गर्न सकिँदैन।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apagar e Substituir exclui todos os seus dados atuais e restaura a partir deste backup. Manter e Mesclar adiciona apenas os registros que ainda não estão neste dispositivo. Apagar e Substituir não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Стереть и заменить» удаляет все текущие данные, а затем восстанавливает их из этой резервной копии. «Сохранить и объединить» добавляет только те записи, которых ещё нет на этом устройстве. «Стереть и заменить» нельзя отменить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "அழித்து மாற்றவும் உங்கள் தற்போதைய தரவு அனைத்தையும் நீக்கி, இந்தக் காப்புப் பிரதியிலிருந்து மீட்டமைக்கும். வைத்து இணைக்கவும் இந்தச் சாதனத்தில் இல்லாத பதிவுகளை மட்டும் சேர்க்கும். அழித்து மாற்றவும் செயலை திரும்பப் பெற முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "తొలగించి భర్తీ చేయి మీ ప్రస్తుత డేటా అంతా తొలగించి, ఈ బ్యాకప్ నుండి పునరుద్ధరిస్తుంది. ఉంచి విలీనం చేయి ఈ పరికరంలో లేని రికార్డులను మాత్రమే జోడిస్తుంది. తొలగించి భర్తీ చేయి రద్దు చేయడం సాధ్యం కాదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sil ve Değiştir, mevcut tüm verilerinizi siler ve ardından bu yedekten geri yükler. Tut ve Birleştir yalnızca bu cihazda olmayan kayıtları ekler. Sil ve Değiştir geri alınamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مٹائیں اور بدلیں آپ کا موجودہ سارا ڈیٹا حذف کر دیتا ہے، پھر اس بیک اپ سے بحال کرتا ہے۔ رکھیں اور ضم کریں صرف وہ ریکارڈز شامل کرتا ہے جو اس آلے پر پہلے سے موجود نہیں ہیں۔ مٹائیں اور بدلیں واپس نہیں ہو سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Xóa & Thay thế sẽ xóa toàn bộ dữ liệu hiện tại của bạn, rồi khôi phục từ bản sao lưu này. Giữ & Gộp chỉ thêm các bản ghi chưa có trên thiết bị này. Xóa & Thay thế không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「清除并替换」会删除当前所有数据，再从此备份恢复。「保留并合并」只添加本机尚无的记录。「清除并替换」无法撤销。"
          }
        }
      }
    },
