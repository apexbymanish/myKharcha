        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पैसा आ गया है। अपने महीने की योजना बनाने के लिए Paisa Khoi? खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uangmu sudah masuk. Buka Paisa Khoi? untuk merencanakan bulanmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給料が入りました。Paisa Khoi?を開いて今月のプランを立てましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돈이 들어왔어요. Paisa Khoi?를 열어 이번 달 계획을 세워보세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे पैसे जमा झाले आहेत. तुमच्या महिन्याचे नियोजन करण्यासाठी Paisa Khoi? उघडा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको पैसा आयो। आफ्नो महिनाको योजना बनाउन Paisa Khoi? खोल्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu dinheiro caiu. Abra o Paisa Khoi? para planejar o mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деньги поступили. Откройте Paisa Khoi?, чтобы спланировать месяц."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் பணம் வந்துவிட்டது. உங்கள் மாதத்தைத் திட்டமிட Paisa Khoi?-வைத் திறக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ డబ్బు వచ్చింది. మీ నెలను ప్లాన్ చేయడానికి Paisa Khoi? తెరవండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paranız hesaba geçti. Ayınızı planlamak için Paisa Khoi?'yı açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی رقم آ گئی ہے۔ اپنے مہینے کی منصوبہ بندی کے لیے Paisa Khoi? کھولیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền của bạn đã về. Mở Paisa Khoi? để lên kế hoạch cho tháng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工资到账啦！打开钱去哪了？来规划本月开支吧。"
