    "This permanently deletes all your transactions, friends, debts, savings, and installments. Categories are reset to defaults." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف هذا نهائيًا جميع معاملاتك وأصدقاءك وديونك ومدخراتك وأقساطك. وتعود الفئات إلى الإعدادات الافتراضية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি আপনার সব লেনদেন, বন্ধু, ধার, সঞ্চয় ও কিস্তি চিরতরে মুছে দেয়। ক্যাটাগরিগুলো ডিফল্টে ফিরে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dabei werden alle deine Buchungen, Freunde, Schulden, Ersparnisse und Ratenzahlungen endgültig gelöscht. Kategorien werden auf die Standardwerte zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto elimina de forma permanente todas tus transacciones, amigos, deudas, ahorros y cuotas. Las categorías se restablecen a los valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela supprime définitivement toutes tes transactions, tes amis, tes dettes, ton épargne et tes mensualités. Les catégories sont réinitialisées aux valeurs par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इससे आपके सारे लेन-देन, दोस्त, उधार, बचत और इंस्टॉलमेंट्स हमेशा के लिए मिट जाएंगे। श्रेणियां डिफ़ॉल्ट पर वापस आ जाएंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ini akan menghapus semua transaksi, teman, utang, tabungan, dan cicilan kamu secara permanen. Kategori akan direset ke pengaturan bawaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "取引、友達、貸し借り、貯金、および分割払いをすべて完全に削除します。カテゴリはデフォルトにリセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 작업은 모든 거래, 친구, 빚, 저축, 할부를 영구적으로 삭제해요. 카테고리는 기본값으로 초기화돼요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यामुळे तुमचे सर्व व्यवहार, मित्र, उधारी, बचत आणि हप्ते कायमचे मिटतात. श्रेण्या डीफॉल्टवर रीसेट होतात."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यसले तपाईंका सबै कारोबार, साथीहरू, सापटी, बचत, र किस्ताहरू स्थायी रूपमा मेटाउँछ। श्रेणीहरू पूर्वनिर्धारित अवस्थामा फर्किन्छन्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isso exclui permanentemente todas as suas transações, amigos, dívidas, poupanças e parcelamentos. As categorias são redefinidas para os padrões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это безвозвратно удалит все ваши операции, друзей, долги, накопления и рассрочки. Категории будут сброшены до стандартных."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "இது உங்கள் பரிவர்த்தனைகள், நண்பர்கள், கடன்கள், சேமிப்பு மற்றும் தவணைகள் அனைத்தையும் நிரந்தரமாக நீக்கும். வகைகள் இயல்புநிலைக்கு மீட்டமைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ఇది మీ అన్ని లావాదేవీలు, స్నేహితులు, బాకీలు, పొదుపు, మరియు వాయిదాలను శాశ్వతంగా తొలగిస్తుంది. వర్గాలు డిఫాల్ట్‌కు రీసెట్ అవుతాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu işlem tüm işlemlerinizi, arkadaşlarınızı, borçlarınızı, birikimlerinizi ve taksitlerinizi kalıcı olarak siler. Kategoriler varsayılanlara sıfırlanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ آپ کے تمام لین دین، دوست، قرضے، بچت اور اقساط ہمیشہ کے لیے مٹا دیتا ہے۔ زمرے ڈیفالٹ پر واپس آ جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn tất cả giao dịch, bạn bè, khoản nợ, tiết kiệm và trả góp của bạn. Danh mục sẽ được đặt lại về mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你所有的交易、好友、欠款、储蓄和分期。分类将恢复默认。"
          }
        }
      }
    },
