        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको शान्त, निजी पैसा ट्र्याकर।"
          }
        }
      }
    },
    "Your commitments exceed your income." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "고정 지출이 수입을 초과합니다."
