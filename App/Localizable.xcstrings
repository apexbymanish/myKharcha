          }
        }
      }
    },
    "Marks every open amount as settled and resets the balance to zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع علامة على كل مبلغ مفتوح بأنه مسوّى ويعيد الرصيد إلى صفر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব বকেয়া পরিমাণ মিটমাট হিসেবে চিহ্নিত করে এবং ব্যালেন্স শূন্যে রিসেট করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert jeden offenen Betrag als beglichen und setzt den Saldo auf null zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca todos los importes pendientes como saldados y restablece el saldo a cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque tous les montants ouverts comme réglés et remet le solde à zéro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बकाया राशि को सेटल्ड चिह्नित करता है और बैलेंस को शून्य कर देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menandai semua nominal terbuka sebagai lunas dan mengatur ulang saldo ke nol."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未精算の金額をすべて精算済みにし、残高をゼロにリセットします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미결제 금액을 모두 정산 처리하고 잔액을 0으로 초기화해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व प्रलंबित रक्कम मिटवलेली म्हणून चिन्हांकित करते आणि शिल्लक शून्यावर आणते."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबै बाँकी रकमलाई फर्छ्यौट भएको चिन्ह लगाउँछ र ब्यालेन्सलाई शून्यमा रिसेट गर्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca todos os valores em aberto como quitados e zera o saldo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает все открытые суммы как погашенные и обнуляет баланс."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எல்லா நிலுவைத் தொகைகளையும் தீர்க்கப்பட்டதாகக் குறித்து, மீதியை பூஜ்ஜியமாக மீட்டமைக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అన్ని బాకీ మొత్తాలను సెటిల్ అయినట్లు గుర్తించి, బ్యాలెన్స్‌ను జీరోకు రీసెట్ చేస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm açık tutarları kapatılmış olarak işaretler ve bakiyeyi sıfırlar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کھلی رقم کو طے شدہ نشان زد کرتا ہے اور بیلنس کو صفر پر ری سیٹ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu mọi khoản còn mở là đã tất toán và đưa số dư về 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把所有未结金额标记为已结清，并将余额归零。"
          }
        }
      }
    },
    "Money you borrowed and repay monthly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
