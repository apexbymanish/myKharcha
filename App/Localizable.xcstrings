    "Log your first expense or income — tap ➕ above, or use a Quick action." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل أول مصروف أو دخل لك — اضغط ➕ أعلاه، أو استخدم إجراءً سريعًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রথম খরচ বা আয় লগ করুন — উপরে ➕ ট্যাপ করুন, অথবা একটি কুইক অ্যাকশন ব্যবহার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse deine erste Ausgabe oder Einnahme – tippe oben auf ➕ oder nutze eine Schnellaktion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tu primer gasto o ingreso: toca ➕ arriba o usa una acción rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre ta première dépense ou ton premier revenu — appuie sur ➕ ci-dessus, ou utilise une action rapide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पहला खर्च या आय दर्ज करें — ऊपर ➕ टैप करें, या किसी क्विक एक्शन का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat pengeluaran atau pemasukan pertamamu — ketuk ➕ di atas, atau gunakan Aksi Cepat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の支出や収入を記録しましょう。上の➕をタップするか、クイックアクションを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 지출이나 수입을 기록해 보세요 — 위의 ➕를 탭하거나 빠른 동작을 사용하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा पहिला खर्च किंवा उत्पन्न नोंदवा — वरील ➕ टॅप करा, किंवा क्विक अ‍ॅक्शन वापरा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफ्नो पहिलो खर्च वा आम्दानी लग गर्नुहोस् — माथिको ➕ ट्याप गर्नुहोस्, वा द्रुत कार्य प्रयोग गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre sua primeira despesa ou receita — toque em ➕ acima, ou use uma ação rápida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите первый расход или доход — нажмите ➕ выше или используйте быстрое действие."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் முதல் செலவு அல்லது வருமானத்தைப் பதிவு செய்யுங்கள் — மேலே ➕ ஐத் தட்டவும், அல்லது ஒரு விரைவு செயலைப் பயன்படுத்தவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ మొదటి ఖర్చు లేదా ఆదాయాన్ని నమోదు చేయండి — పైన ➕ నొక్కండి, లేదా Quick action వాడండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk gider veya gelirinizi kaydedin — yukarıdaki ➕'ye dokunun ya da bir Hızlı işlem kullanın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا پہلا خرچ یا آمدنی درج کریں — اوپر ➕ ٹیپ کریں، یا کوئی فوری عمل استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại khoản chi hoặc thu nhập đầu tiên — chạm ➕ ở trên, hoặc dùng một Thao tác nhanh."
          }
        }
      }
    },
