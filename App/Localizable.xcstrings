        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mensualité est enregistrée automatiquement le jour de l’échéance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक भुगतान देय दिन पर अपने आप दर्ज हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran bulanan dicatat otomatis pada hari jatuh tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の支払いは支払日に自動で記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 납입액은 만기일에 자동으로 기록돼요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक पेमेंट देय दिवशी आपोआप नोंदवले जाते."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक भुक्तानी तिर्ने दिनमा स्वतः लग हुन्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento mensal é registrado automaticamente no dia do vencimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежемесячный платёж записывается автоматически в день оплаты."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாதக் கட்டணம் நிலுவைத் தேதியில் தானாகவே பதிவு செய்யப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెలవారీ చెల్లింపు గడువు రోజున ఆటోమేటిక్‌గా నమోదు అవుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık ödeme, vade gününde otomatik olarak kaydedilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماہانہ ادائیگی خودکار طور پر ادائیگی کے دن درج ہو جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản thanh toán hàng tháng được ghi tự động vào ngày đến hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每期付款会在到期日自动记录。"
          }
        }
      }
    },
    "These are the commitments due within the next week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه هي الالتزامات المستحقة خلال الأسبوع القادم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এগুলো হলো পরবর্তী সপ্তাহের মধ্যে বকেয়া হতে যাওয়া বাধ্যবাধকতা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Verpflichtungen, die in der nächsten Woche fällig werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los compromisos que vencen en la próxima semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les engagements à régler dans la semaine à venir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये अगले हफ़्ते में देय प्रतिबद्धताएं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah komitmen yang jatuh tempo dalam minggu depan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは今後1週間以内に期限を迎える固定費です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 일주일 안에 만기가 되는 고정 지출이에요."
