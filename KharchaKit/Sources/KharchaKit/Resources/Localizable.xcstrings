          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी दोस्त पर आपका जो बकाया है, उसमें से कुछ या पूरा चुकता करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
