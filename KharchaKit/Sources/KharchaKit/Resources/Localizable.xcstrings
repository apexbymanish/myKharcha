    "To keep saving at this rate and cover your usual spending, aim to earn about %@ per month." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاستمرار في الادخار بهذا المعدل وتغطية إنفاقك المعتاد، اسعَ لكسب حوالي %@ شهريًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই হারে সঞ্চয় চালিয়ে যেতে আর আপনার স্বাভাবিক খরচ মেটাতে, প্রতি মাসে প্রায় %@ আয়ের লক্ষ্য রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um weiterhin in diesem Tempo zu sparen und deine üblichen Ausgaben zu decken, solltest du etwa %@ pro Monat verdienen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para seguir ahorrando a este ritmo y cubrir tus gastos habituales, intenta ganar unos %@ al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour continuer à épargner à ce rythme tout en couvrant tes dépenses habituelles, vise environ %@ par mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसी दर पर बचत जारी रखने और अपने सामान्य खर्च को पूरा करने के लिए, हर महीने लगभग %@ कमाने का लक्ष्य रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk tetap menabung dengan laju ini dan menutupi pengeluaran biasamu, usahakan berpenghasilan sekitar %@ per bulan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このペースで貯金しながらいつもの支出をカバーするには、月におよそ%@を稼ぐことを目指しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 속도로 저축하며 평소 지출을 감당하려면, 매달 약 %@를 벌어야 해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या दराने बचत सुरू ठेवण्यासाठी आणि तुमचा नेहमीचा खर्च भागवण्यासाठी, दर महिन्याला अंदाजे %@ कमावण्याचे लक्ष्य ठेवा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसै दरमा बचत गर्दै आफ्नो सामान्य खर्च धान्न, महिनामा लगभग %@ कमाउने लक्ष्य राख्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para manter esse ritmo de poupança e cobrir seus gastos habituais, procure ganhar cerca de %@ por mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы продолжать откладывать в этом темпе и покрывать обычные расходы, старайтесь зарабатывать около %@ в месяц."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த விகிதத்தில் சேமிப்பைத் தொடர்ந்து, உங்கள் வழக்கமான செலவுகளையும் ஈடுகட்ட, மாதத்திற்கு சுமார் %@ சம்பாதிக்க முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ రేటులో పొదుపు కొనసాగిస్తూ, మీ మామూలు ఖర్చులను భరించడానికి, నెలకు దాదాపు %@ సంపాదించాలని లక్ష్యంగా పెట్టుకోండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oranda biriktirmeye devam edip olağan harcamalarınızı karşılamak için ayda yaklaşık %@ kazanmayı hedefleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسی شرح سے بچت جاری رکھنے اور اپنے معمول کے اخراجات پورے کرنے کے لیے، ماہانہ تقریباً %@ کمانے کا ہدف رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tiếp tục tiết kiệm với tốc độ này và trang trải chi tiêu thường ngày, hãy đặt mục tiêu kiếm khoảng %@ mỗi tháng."
          }
        }
      }
    },
