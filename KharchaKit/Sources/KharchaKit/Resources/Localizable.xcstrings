    "To keep saving at this rate and cover your usual spending, aim to earn about %@ per month." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 저축 속도를 유지하면서 평소 지출을 감당하려면 매월 약 %@를 벌어야 합니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यही दरमा बचत जारी राख्दै तपाईंको सामान्य खर्च धान्न, प्रति महिना लगभग %@ कमाउने लक्ष्य राख्नुहोस्।"
