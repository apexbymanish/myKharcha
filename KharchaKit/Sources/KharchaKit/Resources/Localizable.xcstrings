    "Adds a recurring reminder in Kharcha." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تذكيرًا متكررًا في Kharcha."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha-তে একটি রিকারিং রিমাইন্ডার যোগ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine wiederkehrende Erinnerung in Kharcha hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un recordatorio recurrente en Kharcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un rappel récurrent dans Kharcha."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha में एक रिकरिंग रिमाइंडर जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan pengingat berulang di Kharcha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharchaに定期リマインダーを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha에 반복 알림을 추가해요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha मध्ये रिकरिंग स्मरणपत्र जोडते."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha मा दोहोरिने रिमाइन्डर थप्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um lembrete recorrente no Kharcha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет регулярное напоминание в Kharcha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha-வில் தொடர் நினைவூட்டலைச் சேர்க்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharchaలో పునరావృత రిమైండర్‌ను జోడిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha'da tekrarlayan bir hatırlatıcı ekler."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kharcha میں بار بار آنے والی یاد دہانی شامل کرتا ہے۔"
