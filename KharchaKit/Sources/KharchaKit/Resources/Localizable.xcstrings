    "Your commitments (%@) are %@ more than your income of %@. Consider trimming subscriptions or adding income." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your commitments (%1$@) are %2$@ more than your income of %3$@. Consider trimming subscriptions or adding income."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "고정 지출(%1$@)이 수입 %3$@보다 %2$@ 많습니다. 구독을 줄이거나 수입을 늘리는 것을 고려해 보세요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको नियमित खर्च (%1$@) तपाईंको आम्दानी %3$@ भन्दा %2$@ ले बढी छ। सदस्यता घटाउने वा आम्दानी थप्ने विचार गर्नुहोस्।"
          }
        }
      }
