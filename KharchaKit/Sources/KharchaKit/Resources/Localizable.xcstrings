    "After %@ of commitments, you can save %@ and safely spend %@ this month." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد التزامات بقيمة %1$@، يمكنك ادخار %2$@ وإنفاق %3$@ بأمان هذا الشهر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ বাধ্যবাধকতার পর, আপনি এই মাসে %2$@ সঞ্চয় করতে পারবেন এবং নিরাপদে %3$@ খরচ করতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %1$@ an Verpflichtungen kannst du %2$@ sparen und diesen Monat sicher %3$@ ausgeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After %1$@ of commitments, you can save %2$@ and safely spend %3$@ this month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de %1$@ en compromisos, puedes ahorrar %2$@ y gastar con tranquilidad %3$@ este mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après %1$@ d’engagements, tu peux épargner %2$@ et dépenser %3$@ sereinement ce mois-ci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ की प्रतिबद्धताओं के बाद, आप इस महीने %2$@ बचा सकते हैं और सुरक्षित रूप से %3$@ खर्च कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah %1$@ untuk komitmen, kamu bisa menabung %2$@ dan aman membelanjakan %3$@ bulan ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定費%1$@を差し引いた後、今月は%2$@を貯金し、%3$@を安全に使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 지출 %1$@를 낸 후, 이번 달에 %2$@를 저축하고 %3$@를 안전하게 쓸 수 있어요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ जबाबदाऱ्यांनंतर, तुम्ही या महिन्यात %2$@ बचत करू शकता आणि %3$@ सुरक्षितपणे खर्च करू शकता."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ प्रतिबद्धता पूरा गरेपछि, यस महिना तपाईं %2$@ बचत गर्न र %3$@ सुरक्षित रूपमा खर्च गर्न सक्नुहुन्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de %1$@ em compromissos, você pode poupar %2$@ e gastar com segurança %3$@ este mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После %1$@ обязательств вы можете отложить %2$@ и безопасно потратить %3$@ в этом месяце."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ கடமைகளுக்குப் பிறகு, இந்த மாதம் %2$@ சேமித்து, %3$@ பாதுகாப்பாகச் செலவிடலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ కట్టుబాట్ల తర్వాత, మీరు %2$@ పొదుపు చేసి ఈ నెల సురక్షితంగా %3$@ ఖర్చు చేయవచ్చు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ taahhütten sonra, bu ay %2$@ biriktirip %3$@ güvenle harcayabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ کے واجبات کے بعد، آپ اس مہینے %2$@ بچا سکتے ہیں اور %3$@ محفوظ طریقے سے خرچ کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau %1$@ tiền cam kết, bạn có thể tiết kiệm %2$@ và an toàn chi tiêu %3$@ trong tháng này."
          }
        }
      }
    },
