    "Your commitments (%@) are %@ more than your income of %@. Consider trimming subscriptions or adding income." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التزاماتك (%1$@) أكبر من دخلك البالغ %3$@ بمقدار %2$@. فكّر في تقليل الاشتراكات أو زيادة الدخل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বাধ্যবাধকতা (%1$@) আপনার %3$@ আয়ের চেয়ে %2$@ বেশি। সাবস্ক্রিপশন কমানো বা আয় বাড়ানোর কথা ভাবুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Verpflichtungen (%1$@) übersteigen dein Einkommen von %3$@ um %2$@. Erwäge, Abonnements zu reduzieren oder dein Einkommen zu erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your commitments (%1$@) are %2$@ more than your income of %3$@. Consider trimming subscriptions or adding income."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus compromisos (%1$@) superan en %2$@ tus ingresos de %3$@. Considera recortar suscripciones o aumentar tus ingresos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes engagements (%1$@) dépassent de %2$@ ton revenu de %3$@. Envisage de réduire tes abonnements ou d’augmenter tes revenus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रतिबद्धताएं (%1$@) आपकी %3$@ की आय से %2$@ ज़्यादा हैं। सब्सक्रिप्शन घटाने या आय बढ़ाने पर विचार करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komitmenmu (%1$@) %2$@ lebih besar dari pemasukanmu sebesar %3$@. Pertimbangkan untuk mengurangi langganan atau menambah pemasukan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定費（%1$@）が収入%3$@を%2$@上回っています。サブスクリプションを見直すか、収入を増やすことを検討しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 지출(%1$@)이 수입 %3$@보다 %2$@ 더 많아요. 구독을 줄이거나 수입을 늘려보세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या जबाबदाऱ्या (%1$@) तुमच्या %3$@ उत्पन्नापेक्षा %2$@ जास्त आहेत. सबस्क्रिप्शन्स कमी करण्याचा किंवा उत्पन्न वाढवण्याचा विचार करा."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको प्रतिबद्धता (%1$@) तपाईंको %3$@ आम्दानीभन्दा %2$@ बढी छ। सब्स्क्रिप्सन घटाउने वा आम्दानी थप्ने विचार गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus compromissos (%1$@) são %2$@ maiores que sua receita de %3$@. Considere reduzir assinaturas ou aumentar sua receita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши обязательства (%1$@) на %2$@ больше вашего дохода (%3$@). Подумайте о сокращении подписок или увеличении дохода."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கடமைகள் (%1$@) உங்கள் வருமானமான %3$@-ஐ விட %2$@ அதிகமாக உள்ளன. சந்தாக்களைக் குறைக்க அல்லது வருமானத்தைச் சேர்க்க பரிசீலிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కట్టుబాట్లు (%1$@) మీ ఆదాయం %3$@ కంటే %2$@ ఎక్కువగా ఉన్నాయి. సబ్‌స్క్రిప్షన్‌లను తగ్గించడం లేదా ఆదాయాన్ని పెంచడం పరిశీలించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taahhütleriniz (%1$@), %3$@ olan gelirinizden %2$@ daha fazla. Abonelikleri azaltmayı veya gelir eklemeyi düşünün."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
