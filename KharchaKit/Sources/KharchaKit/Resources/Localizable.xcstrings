        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salda parte o la totalidad de lo que te debe un amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle tout ou partie de ce qu’un ami te doit."
          }
