    "Settles some or all of what a friend owes you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسوّي بعض أو كل ما يدين لك به صديقك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একজন বন্ধু আপনাকে যা দেয় তার কিছু বা সবটা মিটিয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht einen Teil oder die gesamte Schuld eines Freundes aus."
          }
